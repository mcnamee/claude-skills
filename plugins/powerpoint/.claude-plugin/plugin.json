{
  "name": "powerpoint",
  "displayName": "PowerPoint (.pptx)",
  "version": "4.0.0",
  "description": "Build PowerPoint decks that inherit your own template's styling, and audit them against Guy Kawasaki's 10/20/30 rule.",
  "author": {
    "name": "mcnamee"
  },
  "repository": "https://github.com/mcnamee/claude-skills",
  "license": "MIT",
  "keywords": [
    "powerpoint",
    "pptx",
    "presentation",
    "slides",
    "kawasaki"
  ],
  "mcpServers": {
    "powerpoint": {
      "type": "stdio",
      "command": "${EVA_PYTHON}",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/powerpoint.py"
      ],
      "env": {
        "PYTHONUTF8": "1"
      }
    }
  }
}
