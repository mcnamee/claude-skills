{
  "_comment": [
    "Project-scoped MCP config for Claude Code. Copy this file to '.mcp.json' in",
    "the folder you open Claude Code in, delete the servers you do not use, and",
    "replace every C:\\path\\to\\... with a real absolute path.",
    "",
    "  - Every folder below is part of the Eva working tree. Copy the repo's",
    "    'eva' folder to C:\\Eva first and they all exist, correctly related to",
    "    each other; see eva\\README.md. These are also the built-in defaults,",
    "    so you can delete any folder argument you have not changed.",
    "  - The folder that matters most: C:\\Eva\\knowledge is the knowledge-base",
    "    server's --docs-dir, and every OTHER server's Markdown output goes to a",
    "    sub-folder of it. Point a --kb-dir somewhere outside that folder and it",
    "    will fill up faithfully while the RAG index never reads a line of it.",
    "  - 'command' must be the SAME python.exe you installed the pip",
    "    dependencies into (see the README's 'Install everything at once').",
    "  - Backslashes are DOUBLED because this is JSON.",
    "  - PYTHONUTF8=1 stops Windows' legacy codepage corrupting the stdio",
    "    JSON-RPC stream on non-ASCII content. Keep it.",
    "  - Secrets go in 'env', never in 'args': command lines are visible to",
    "    other local users in process listings.",
    "  - Pass 'off' to an optional folder to switch that feature off, e.g.",
    "    '--kb-dir', 'off' on outlook to keep no local copy of any email.",
    "  - 'word' and 'powerpoint' each take their OWN templates folder,",
    "    C:\\Eva\\templates\\word and C:\\Eva\\templates\\powerpoint. Both are",
    "    read-only: every save into one is refused, so the blanks stay blank.",
    "  - 'confluence' is shown with TWO instances. One is enough: delete the",
    "    CONFLUENCE_NAME* and *_2 settings and it behaves as it always has.",
    "    Keep them and a prompt can say '...on Blue' to reach the second",
    "    instance; anything that does not name a server uses the first. Each",
    "    instance needs its own token.",
    "  - Run each server's --check before wiring it in, e.g.",
    "      & \"C:\\path\\to\\python.exe\" C:\\path\\to\\claude-skills\\plugins\\word\\word.py --check",
    "      (PowerShell: the leading & is required when the path is quoted)",
    "",
    "The recommended install is the Claude Code plugin route instead - see the",
    "root README.md. This file is the manual, project-scoped alternative.",
    "This _comment key is ignored by Claude Code."
  ],
  "mcpServers": {
    "word": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\word\\word.py",
        "--author", "Matt",
        "--docs-dir", "C:\\Eva\\documents\\word",
        "--templates-dir", "C:\\Eva\\templates\\word",
        "--kb-dir", "C:\\Eva\\knowledge\\word"
      ],
      "env": { "PYTHONUTF8": "1" }
    },
    "powerpoint": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\powerpoint\\powerpoint.py",
        "--docs-dir", "C:\\Eva\\documents\\powerpoint",
        "--templates-dir", "C:\\Eva\\templates\\powerpoint",
        "--kb-dir", "C:\\Eva\\knowledge\\powerpoint"
      ],
      "env": { "PYTHONUTF8": "1" }
    },
    "excel": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\excel\\excel.py",
        "--docs-dir", "C:\\Eva\\documents\\excel"
      ],
      "env": { "PYTHONUTF8": "1" }
    },
    "outlook": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\outlook\\outlook.py",
        "--search-folders", "Inbox,Sent Items,Archive",
        "--kb-dir", "C:\\Eva\\knowledge\\email"
      ],
      "env": { "PYTHONUTF8": "1" }
    },
    "confluence": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\confluence\\confluence.py",
        "--max-body", "20000",
        "--kb-dir", "C:\\Eva\\knowledge\\confluence"
      ],
      "env": {
        "CONFLUENCE_NAME": "Green",
        "CONFLUENCE_BASE_URL": "https://green.confluence.internal.example.com",
        "CONFLUENCE_TOKEN": "token-for-the-first-server",
        "CONFLUENCE_NAME_2": "Blue",
        "CONFLUENCE_BASE_URL_2": "https://blue.confluence.internal.example.com",
        "CONFLUENCE_TOKEN_2": "token-for-the-second-server",
        "PYTHONUTF8": "1"
      }
    },
    "jira": {
      "command": "C:\\path\\to\\python.exe",
      "args": ["C:\\path\\to\\claude-skills\\plugins\\jira\\jira.py"],
      "env": {
        "JIRA_BASE_URL": "https://jira.internal.example.com",
        "JIRA_TOKEN": "your-personal-access-token",
        "JIRA_PROJECTS": "ABC,DEF",
        "PYTHONUTF8": "1"
      }
    },
    "knowledge-base": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\knowledge-base\\knowledge-base.py",
        "--docs-dir", "C:\\Eva\\knowledge",
        "--index-dir", "C:\\Eva\\index",
        "--output-dir", "C:\\Eva\\knowledge\\captures",
        "--embed-url", "https://ai-gateway.internal.example.com/v1/embeddings",
        "--embed-model", "text-embedding-3-small"
      ],
      "env": {
        "KB_EMBED_API_KEY": "your-api-key",
        "PYTHONUTF8": "1"
      }
    },
    "pdf2md": {
      "command": "C:\\path\\to\\python.exe",
      "args": [
        "C:\\path\\to\\claude-skills\\plugins\\pdf-to-md\\pdf-to-md.py",
        "--docs-dir", "C:\\Eva\\documents\\pdf",
        "--output-dir", "C:\\Eva\\knowledge\\pdf"
      ],
      "env": { "PYTHONUTF8": "1" }
    }
  }
}
